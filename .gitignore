# *.iws
# .project
# .classpath
# .settings/
# *.sublime-workspace
# *.sublime-project

# If you're using a specific DB that creates local files not covered by DATABASE_URL (e.g. local PostgreS data dir)
# /data/ # Example for PostgreSQL data directory if stored locally and not managed elsewhere
# *.db # General catch-all for database files, could be too broad.

# Temporary files
*.tmp
*.bak
*.swp
*~
# If your bot creates media or other temporary files not meant for version control
/media_temp/
/downloaded_files/
